{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bug.schema.json",
  "title": "Normalized bug",
  "type": "object",
  "required": ["source_file", "source_row", "bug_id", "title", "severity", "description", "expected_behavior", "actual_behavior", "bug_type", "root_cause_category", "affected_module", "environment", "agent_review_status"],
  "properties": {
    "source_file": {"type": "string"},
    "source_row": {"type": "integer", "minimum": 1},
    "bug_id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "severity": {"type": "string"},
    "description": {"type": "string"},
    "expected_behavior": {"type": "string"},
    "actual_behavior": {"type": "string"},
    "preconditions": {"type": "string"},
    "bug_type": {"type": "string"},
    "root_cause_category": {"type": "string"},
    "root_cause_cluster": {"type": "string"},
    "affected_module": {"type": "string"},
    "environment": {"type": "string"},
    "status": {"type": "string"},
    "created_at": {"type": "string"},
    "detected_at": {"type": "string"},
    "resolved_at": {"type": "string"},
    "reopened": {"type": "string", "enum": ["true", "false", "unknown"]},
    "dev_analysis_notes": {"type": "string"},
    "qa_analysis_notes": {"type": "string"},
    "version": {"type": "string"},
    "team": {"type": "string"},
    "prd_reference": {"type": "string"},
    "cluster_id": {"type": "string"},
    "duplicate_family_id": {"type": "string"},
    "agent_suggested_severity": {"type": "string"},
    "agent_suggested_bug_type": {"type": "string"},
    "agent_suggested_root_cause_category": {"type": "string"},
    "agent_suggestion_confidence": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
    "agent_suggestion_rationale": {"type": "string"},
    "agent_review_status": {"type": "string", "enum": ["consistent", "questionable", "unsupported", "conflicting", "insufficient_evidence"]}
  },
  "additionalProperties": true
}

