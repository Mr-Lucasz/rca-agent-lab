{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "RCA evidence",
  "type": "object",
  "required": ["evidence_id", "source_type", "source_ref", "excerpt", "reliability"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EV-"},
    "source_type": {"type": "string", "enum": ["title", "description", "actual_behavior", "expected_behavior", "qa_note", "dev_note", "reported_classification", "code", "git", "pull_request", "log", "trace", "metric", "observability", "documentation", "test"]},
    "source_ref": {"type": "string", "minLength": 1},
    "bug_id": {"type": ["string", "null"]},
    "excerpt": {"type": "string", "minLength": 1, "maxLength": 1000},
    "reliability": {"type": "string", "enum": ["high", "medium", "low"]},
    "observed_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}

