{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "RCA evidence",
  "type": "object",
  "required": ["evidence_id", "source_type", "source_ref", "excerpt", "reliability", "evidence_role", "epistemic_status"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EV-"},
    "source_type": {"type": "string", "enum": ["title", "description", "actual_behavior", "expected_behavior", "qa_note", "dev_note", "reported_classification", "code", "git", "pull_request", "log", "trace", "metric", "observability", "documentation", "test"]},
    "source_ref": {"type": "string", "minLength": 1},
    "bug_id": {"type": ["string", "null"]},
    "excerpt": {"type": "string", "minLength": 1, "maxLength": 1000},
    "reliability": {"type": "string", "enum": ["high", "medium", "low", "unassessed"]},
    "reliability_basis": {"type": "string", "minLength": 8},
    "evidence_role": {
      "type": "string",
      "enum": ["reported_statement", "reported_causal_signal", "observed_artifact", "derived_metric", "external_record"]
    },
    "epistemic_status": {
      "type": "string",
      "enum": ["unverified", "corroborated", "contradicted", "verified"]
    },
    "observed_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}

